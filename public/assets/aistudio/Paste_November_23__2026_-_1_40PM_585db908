        function renderAdminStatistics() {
            const total = globalLeaderboardData.length;
            document.getElementById('stat-total-players').innerText = total;

            if (total === 0) {
                document.getElementById('stat-avg-score').innerText = '0';
                document.getElementById('stat-max-score').innerText = '0';
                document.getElementById('stat-avg-correct').innerText = '0%';
            } else {
                const sumScore = globalLeaderboardData.reduce((acc, p) => acc + (p.score || 0), 0);
                const maxScore = Math.max(...globalLeaderboardData.map(p => p.score || 0));
                const avgPct = Math.round(globalLeaderboardData.reduce((acc, p) => acc + ((p.correct || 0) / (p.totalQuestions || quizQuestions.length) * 100), 0) / total);

                document.getElementById('stat-avg-score').innerText = Math.round(sumScore / total);
                document.getElementById('stat-max-score').innerText = maxScore;
                document.getElementById('stat-avg-correct').innerText = `${avgPct}%`;
            }

            // Statistik Ketepatan Per Soal
            const qStatsContainer = document.getElementById('admin-question-stats');
            qStatsContainer.innerHTML = '';
            quizQuestions.forEach((q, idx) => {
                let answeredCount = 0;
                let correctTimes = 0;
                globalLeaderboardData.forEach(p => {
                    if (Array.isArray(p.history) && p.history[idx]) {
                        answeredCount++;
                        if (p.history[idx].isCorrect) correctTimes++;
                    }
                });
                const pct = answeredCount > 0 ? Math.round((correctTimes / answeredCount) * 100) : 0;
                const card = document.createElement('div');
                card.className = "bg-slate-950/50 border border-white/10 rounded-xl p-3";
                card.innerHTML = `
                    <div class="flex justify-between text-xs font-bold mb-1">
                        <span class="text-purple-200">Soal ${idx + 1} (${escapeHtml(q.category)})</span>
                        <span class="text-emerald-400">${pct}% Benar (${correctTimes}/${answeredCount})</span>
                    </div>
                    <p class="text-xs text-white truncate mb-2">${escapeHtml(q.question)}</p>
                    <div class="w-full bg-white/10 h-2 rounded-full overflow-hidden">
                        <div class="bg-emerald-400 h-full" style="width: ${pct}%"></div>
                    </div>
                `;
                qStatsContainer.appendChild(card);
            });

            // Tabel Lengkap Peserta
            const tbody = document.getElementById('admin-participants-table');
            tbody.innerHTML = '';
