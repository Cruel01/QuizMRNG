            if (!id) {
                let tz = 'UTC';
                try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (e) {}
                const raw = [
                    navigator.userAgent || 'UA',
                    (screen.width || 0) + 'x' + (screen.height || 0),
                    tz,
                    Math.random().toString(36).substring(2, 10)
                ].join('|');
                let hash = 0;
                for (let i = 0; i < raw.length; i++) {
                    hash = ((hash << 5) - hash) + raw.charCodeAt(i);
                    hash |= 0;
                }
                id = 'DEV-' + Math.abs(hash).toString(36).toUpperCase() + '-' + Date.now().toString(36).toUpperCase();
                safeSetStorage('quiz_device_fingerprint_v1', id);
            }
            return id;
        }
        const DEVICE_ID = getDeviceId();

        // ==========================================
        // SINKRONISASI MODE SESI (DEFAULT MENUNGGU ADMIN & KUNCI SILANG)
        // ==========================================
        function getSessionLockFlags() {
            const hasFreeEngagement = (globalLeaderboardData.length > 0 || activeFreePlayers.length > 0);
            const hasLiveEngagement = (waitingRoomPlayers.length > 0 || sessionMode === 'live_started');
            const isFreeLockedOut = (sessionMode === 'live_waiting' || sessionMode === 'live_started') && hasLiveEngagement;
            const isLiveLockedOut = (sessionMode === 'free') && hasFreeEngagement;
            return { hasFreeEngagement, hasLiveEngagement, isFreeLockedOut, isLiveLockedOut };
        }

