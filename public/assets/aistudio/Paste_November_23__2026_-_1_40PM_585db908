    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, deleteDoc, getDocs, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyDc4enJaM3x9wFIWbIv7HSMJocCggAkP7E",
            authDomain: "quizmrng.firebaseapp.com",
            projectId: "quizmrng",
            storageBucket: "quizmrng.firebasestorage.app",
            messagingSenderId: "110916327233",
            appId: "1:110916327233:web:54f4b5abb6730f2de173c0",
            measurementId: "G-BZHTSHPJLN"
        };

        const appId = 'quizmrng-public-v1';
        let db = null;

        function setCloudBadge(status, text) {
            const dot = document.getElementById('cloud-status-dot');
            const label = document.getElementById('cloud-status-text');
            if (!dot || !label) return;
            label.innerText = text;
            dot.className = "w-2 h-2 rounded-full " + (
                status === 'ok' ? "bg-emerald-400" :
                status === 'err' ? "bg-rose-500" : "bg-amber-400 animate-pulse"
            );
        }

        async function initFirebaseSync() {
            try {
                const app = initializeApp(firebaseConfig);
                const auth = getAuth(app);
                db = getFirestore(app);

                try {
                    await signInAnonymously(auth);
                } catch (authErr) {
                    console.warn("Auth anonim dilewati:", authErr.code || authErr.message);
                }

                // 1. Dengarkan Perubahan Leaderboard Real-Time & Status Kunci Perangkat
                const lbCol = collection(db, 'artifacts', appId, 'public', 'data', 'leaderboard');
                onSnapshot(lbCol, (snapshot) => {
                    setCloudBadge('ok', 'Cloud Terhubung');
                    const list = [];
                    let foundThisDeviceInCloud = false;
                    snapshot.forEach((docSnap) => {
                        const data = docSnap.data();
                        list.push(data);
                        if (data.deviceId === DEVICE_ID) {
                            foundThisDeviceInCloud = true;
                            safeSetStorage('quiz_completed_record_' + DEVICE_ID, JSON.stringify(data));
                            applyDeviceLockUI(data);
                        }
                    });
                    // Jika Admin menghapus peserta ini di cloud, buka kembali kunci perangkatnya
                    if (!foundThisDeviceInCloud && hasPlayedThisDevice) {
                        unlockThisDeviceUI();
                    }
                    renderLeaderboardList(list);
                    if (!document.getElementById('screen-admin').classList.contains('hidden')) {
                        renderAdminStatistics();
                    }
                }, (err) => {
                    console.error("Firestore permission/listener error:", err);
                    setCloudBadge('err', 'Cek Rules Firestore!');
                });

                // 2. Dengarkan Perubahan Bank Soal CRUD dari Admin
                const configDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'questions_v2');
                onSnapshot(configDocRef, (docSnap) => {
                    if (docSnap.exists() && Array.isArray(docSnap.data().items) && docSnap.data().items.length > 0) {
                        quizQuestions = docSnap.data().items;
                        safeSetStorage('quiz_custom_questions_v2', JSON.stringify(quizQuestions));
                        updateLobbyCategoryStats();
                        if (!document.getElementById('screen-admin').classList.contains('hidden')) {
                            renderAdminCrudQuestions();
                        }
                    }
                });

                // 3. Dengarkan Status Sesi Live / Bebas dari Admin
                const sessionDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'session');
                onSnapshot(sessionDocRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const s = docSnap.data();
                        if (s && s.mode) {
                            sessionMode = s.mode;
                            liveSessionRunId = s.runId || 'default';
                            applySessionModeUI();
                        }
                    }
                });

                // 4. Dengarkan Daftar Peserta di Ruang Tunggu Live
                const waitCol = collection(db, 'artifacts', appId, 'public', 'data', 'waiting_room');
                onSnapshot(waitCol, (snapshot) => {
                    const wList = [];
                    snapshot.forEach(d => wList.push(d.data()));
                    waitingRoomPlayers = wList.sort((a, b) => (a.joinedAt || 0) - (b.joinedAt || 0));
                    renderWaitingPlayersUI();
                    applySessionModeUI();
                });

                // 4B. Dengarkan Peserta yang Sedang Mengerjakan Kuis (Untuk Penguncian Mode Bebas/Live)
                const activeCol = collection(db, 'artifacts', appId, 'public', 'data', 'active_players');
                onSnapshot(activeCol, (snapshot) => {
                    const aList = [];
                    snapshot.forEach(d => aList.push(d.data()));
                    activeFreePlayers = aList;
                    applySessionModeUI();
                });

                // 5. Dengarkan Sabotase / Debuff Real-Time untuk Perangkat Ini
                const sabotageDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'sabotage', DEVICE_ID);
                let lastHandledSabotageTs = 0;
                onSnapshot(sabotageDocRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const sData = docSnap.data();
                        if (sData && sData.createdAt && sData.createdAt > lastHandledSabotageTs && (Date.now() - sData.createdAt < 15000)) {
                            lastHandledSabotageTs = sData.createdAt;
                            if (typeof window.handleIncomingSabotage === 'function') {
                                window.handleIncomingSabotage(sData);
                            }
                        }
                    }
                });

            } catch (error) {
                console.error("Gagal inisialisasi Firebase:", error);
                setCloudBadge('err', 'Offline / Gagal Konek');
            }
        }

        window.saveSessionStateToCloud = async function(sessionPayload) {
            if (!db) return;
            try {
                const sessionDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'session');
                await setDoc(sessionDocRef, sessionPayload);
            } catch (e) {
                console.error("Gagal menyimpan status sesi:", e);
            }
        };

        window.joinWaitingRoomCloud = async function(playerPayload) {
            if (!db) return;
            try {
                const wRef = doc(db, 'artifacts', appId, 'public', 'data', 'waiting_room', playerPayload.deviceId);
                await setDoc(wRef, playerPayload);
            } catch (e) {
                console.error("Gagal masuk ruang tunggu:", e);
            }
        };

        window.leaveWaitingRoomCloud = async function(devId) {
            if (!db || !devId) return;
            try {
                const wRef = doc(db, 'artifacts', appId, 'public', 'data', 'waiting_room', devId);
                await deleteDoc(wRef);
            } catch (e) {}
        };

        window.registerActivePlayerCloud = async function(playerPayload) {
            if (!db || !playerPayload.deviceId) return;
            try {
                const aRef = doc(db, 'artifacts', appId, 'public', 'data', 'active_players', playerPayload.deviceId);
                await setDoc(aRef, playerPayload);
            } catch (e) {}
