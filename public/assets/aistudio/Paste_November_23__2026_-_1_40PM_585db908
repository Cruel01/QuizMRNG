        function saveCrudQuestion() {
            const editIdx = parseInt(document.getElementById('crud-edit-index').value, 10);
            const category = document.getElementById('crud-category').value;
            const type = document.getElementById('crud-type').value;
            const time = parseInt(document.getElementById('crud-time').value, 10) || 25;
            const question = document.getElementById('crud-question').value.trim();
            const explanation = document.getElementById('crud-explanation').value.trim() || "Jawaban sesuai kunci yang ditetapkan admin.";
            const errEl = document.getElementById('crud-form-error');

            if (!question) {
                errEl.innerText = "Teks pertanyaan wajib diisi!";
                errEl.classList.remove('hidden');
                return;
            }

            let newObj = { category, type, time, question, explanation };

            if (type === 'MC') {
                const opts = [0, 1, 2, 3].map(i => document.getElementById(`crud-opt-${i}`).value.trim());
                if (opts.some(o => !o)) {
                    errEl.innerText = "Keempat opsi jawaban A–D wajib diisi!";
                    errEl.classList.remove('hidden');
                    return;
                }
                newObj.options = opts;
                newObj.answer = parseInt(document.getElementById('crud-answer-mc').value, 10);
            } else if (type === 'TF') {
                newObj.options = ["Benar (True)", "Salah (False)"];
                newObj.answer = parseInt(document.getElementById('crud-answer-tf').value, 10);
            } else if (type === 'MS') {
                const opts = [0, 1, 2, 3].map(i => document.getElementById(`crud-opt-${i}`).value.trim());
                const checked = Array.from(document.querySelectorAll('.crud-ms-check:checked')).map(cb => parseInt(cb.value, 10));
                if (opts.some(o => !o) || checked.length === 0) {
                    errEl.innerText = "Isi semua opsi A–D dan centang minimal 1 jawaban benar!";
                    errEl.classList.remove('hidden');
                    return;
                }
                newObj.options = opts;
                newObj.answer = checked;
            } else if (type === 'TEXT') {
                const rawAns = document.getElementById('crud-answer-text').value.split(',').map(s => s.trim()).filter(Boolean);
                if (rawAns.length === 0) {
                    errEl.innerText = "Masukkan minimal 1 kata kunci jawaban!";
                    errEl.classList.remove('hidden');
                    return;
                }
                newObj.acceptedAnswers = rawAns;
            }

            if (editIdx >= 0) quizQuestions[editIdx] = newObj;
            else quizQuestions.push(newObj);

            syncQuestionsStorageAndCloud();
            closeQuestionEditorModal();
            renderAdminCrudQuestions();
            renderAdminStatistics();
        }

        function deleteCrudQuestion(idx) {
            if (quizQuestions.length <= 1) {
                showToast("Minimal harus tersisa 1 soal di dalam kuis!");
                return;
            }
            quizQuestions.splice(idx, 1);
            syncQuestionsStorageAndCloud();
            renderAdminCrudQuestions();
            renderAdminStatistics();
            showToast("Soal berhasil dihapus.");
        }

        function syncQuestionsStorageAndCloud() {
            safeSetStorage('quiz_custom_questions_v2', JSON.stringify(quizQuestions));
            updateLobbyCategoryStats();
            if (typeof window.saveQuestionsToCloud === 'function') {
                window.saveQuestionsToCloud(quizQuestions);
