        function backToLockedLobby() {
            document.getElementById('screen-leaderboard').classList.add('hidden');
            document.getElementById('screen-start').classList.remove('hidden');
        }

        function upsertLocalLeaderboard(record) {
            const idx = globalLeaderboardData.findIndex(p => p.deviceId === record.deviceId);
            if (idx >= 0) globalLeaderboardData[idx] = record;
            else globalLeaderboardData.push(record);
            renderLeaderboardList(globalLeaderboardData);
        }

        function renderLeaderboardList(data) {
            globalLeaderboardData = [...data].sort((a, b) => (b.score || 0) - (a.score || 0));
            applySessionModeUI();
            const container = document.getElementById('leaderboard-list');
            const lobbyLbBtn = document.getElementById('btn-lobby-leaderboard');

            if (globalLeaderboardData.length > 0 && lobbyLbBtn) {
                lobbyLbBtn.classList.remove('hidden');
            } else if (lobbyLbBtn && !hasPlayedThisDevice) {
                lobbyLbBtn.classList.add('hidden');
            }

            if (!container) return;
            if (globalLeaderboardData.length === 0) {
                container.innerHTML = `<div class="p-8 text-center text-sm text-purple-200">Belum ada peserta yang menyelesaikan kuis.</div>`;
                return;
            }

            container.innerHTML = '';
            globalLeaderboardData.forEach((player, index) => {
                const rank = index + 1;
                const isMe = (player.deviceId === DEVICE_ID);
                let rankBadge = `<span class="font-bold text-purple-200">#${rank}</span>`;
                if (rank === 1) rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-400 text-slate-950 font-extrabold text-xs"><i class="fa-solid fa-crown"></i></span>`;
                else if (rank === 2) rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-300 text-slate-950 font-extrabold text-xs">2</span>`;
                else if (rank === 3) rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-700 text-white font-extrabold text-xs">3</span>`;

                const row = document.createElement('div');
                row.className = `grid grid-cols-12 items-center px-4 py-3.5 text-sm ${isMe ? 'bg-indigo-500/30 font-bold' : ''}`;
                row.innerHTML = `
                    <div class="col-span-2 text-center">${rankBadge}</div>
                    <div class="col-span-5 truncate pr-2 flex items-center gap-2">
                        <span class="truncate">${escapeHtml(player.name)}</span>
                        ${isMe ? '<span class="text-[10px] uppercase bg-amber-400 text-slate-950 px-1.5 py-0.5 rounded font-extrabold shrink-0">Kamu</span>' : ''}
                    </div>
                    <div class="col-span-2 text-center text-emerald-300 font-semibold">${player.correct}/${player.totalQuestions || quizQuestions.length}</div>
                    <div class="col-span-3 text-right font-extrabold text-amber-400">${player.score}</div>
                `;
                container.appendChild(row);
            });
        }

