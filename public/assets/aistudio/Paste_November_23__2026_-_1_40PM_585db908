        // ==========================================
        // SISTEM POWER-UP SEIMBANG (2 SLOT INVENTORY)
        // ==========================================
        function rollWeightedPowerup(onlyKind = null) {
            const pool = Object.values(POWERUP_CATALOG).filter(item => !onlyKind || item.kind === onlyKind);
            const totalWeight = pool.reduce((sum, item) => sum + item.weight, 0);
            let r = Math.random() * totalWeight;
            for (const item of pool) {
                if (r < item.weight) return item.id;
                r -= item.weight;
            }
            return pool[0] ? pool[0].id : 'FIFTY_FIFTY';
        }

        function grantPowerupToInventory(powerupId, sourceLabel = '') {
            const spec = POWERUP_CATALOG[powerupId];
            if (!spec) return false;
            const emptyIdx = powerupInventory.findIndex(slot => slot === null);
            if (emptyIdx === -1) {
                score += 50;
                document.getElementById('current-score').innerText = score;
                showToast(`Slot penuh (Maks. 2)! ${sourceLabel ? sourceLabel + ' ' : ''}dikonversi menjadi +50 poin bonus.`);
                renderInventoryUI();
                return false;
            }
            powerupInventory[emptyIdx] = powerupId;
            renderInventoryUI();
            showToast(`${sourceLabel ? sourceLabel + ': ' : ''}Dapat item ${spec.name}!`);
            return true;
        }

        function renderInventoryUI() {
            const targetStreak = getStreakRewardTarget();
            const streakEl = document.getElementById('hud-streak-count');
            if (streakEl && streakEl.parentElement) {
                streakEl.parentElement.innerHTML = `<i class="fa-solid fa-fire mr-1"></i>Streak: <span id="hud-streak-count">${currentStreak}</span>/${targetStreak}`;
            }

            const slotsContainer = document.getElementById('inventory-slots');
            if (!slotsContainer) return;
            slotsContainer.innerHTML = '';

            for (let i = 0; i < MAX_POWERUP_SLOTS; i++) {
                const itemId = powerupInventory[i];
                const slotDiv = document.createElement('div');
                if (!itemId || !POWERUP_CATALOG[itemId]) {
                    slotDiv.className = "rounded-xl border border-dashed border-white/20 bg-slate-950/30 px-3 py-2 text-[11px] text-purple-300/60 flex items-center justify-center font-semibold";
                    slotDiv.innerHTML = `<span>Slot ${i + 1} Kosong</span>`;
                } else {
                    const spec = POWERUP_CATALOG[itemId];
                    const disabledUse = powerupUsedThisQuestion || isFrozenByOpponent;
                    slotDiv.className = `rounded-xl border px-3 py-1.5 flex items-center justify-between gap-2 ${spec.badgeClass}`;
                    slotDiv.innerHTML = `
                        <div class="flex items-center gap-1.5 min-w-0" title="${spec.desc}">
                            <i class="fa-solid ${spec.icon} shrink-0"></i>
                            <span class="text-xs font-extrabold truncate">${spec.name}</span>
                        </div>
                        <button onclick="activatePowerupSlot(${i})" ${disabledUse ? 'disabled' : ''}
                            class="text-[11px] font-extrabold px-2 py-1 rounded-lg bg-white/90 hover:bg-white text-slate-950 disabled:opacity-40 disabled:cursor-not-allowed transition shrink-0 cursor-pointer">
                            Pakai
                        </button>
                    `;
                }
                slotsContainer.appendChild(slotDiv);
            }
        }

        function activatePowerupSlot(slotIdx) {
            if (powerupUsedThisQuestion || isFrozenByOpponent) return;
            const fbVisible = !document.getElementById('feedback-box').classList.contains('hidden');
            if (fbVisible) {
                showToast("Gunakan item sebelum menjawab soal!");
                return;
            }

            const itemId = powerupInventory[slotIdx];
            const spec = itemId && POWERUP_CATALOG[itemId];
            if (!spec) return;

            const q = quizQuestions[currentQuestionIndex];
            if (itemId === 'FIFTY_FIFTY' && (q.type !== 'MC' && q.type !== 'MS')) {
                showToast("Item 50:50 hanya bisa dipakai pada soal pilihan ganda!");
                return;
            }

            powerupInventory[slotIdx] = null;
            powerupUsedThisQuestion = true;

            if (itemId === 'DOUBLE_SCORE') {
                doubleScoreActiveThisQuestion = true;
                showToast("Skor 2x aktif untuk soal ini!");
            } else if (itemId === 'FIFTY_FIFTY') {
                applyFiftyFiftyToCurrentQuestion(q);
                showToast("2 opsi jawaban yang salah telah dihapus!");
            } else if (itemId === 'SHIELD') {
                immuneQuestionsRemaining = Math.max(immuneQuestionsRemaining, 2);
                showToast("Perisai aktif! Kamu kebal terhadap Debuff lawan.");
            } else if (itemId === 'FREEZE_LEADER') {
                triggerSabotageOnLeader('FREEZE_LEADER');
            } else if (itemId === 'GLITCH_SHUFFLE') {
                triggerSabotageOnLeader('GLITCH_SHUFFLE');
            }

            renderInventoryUI();
        }

        function applyFiftyFiftyToCurrentQuestion(q) {
            const correctIndices = Array.isArray(q.answer) ? q.answer : [q.answer];
            const buttons = Array.from(document.querySelectorAll('#options-container button'));
            const wrongButtons = buttons.filter(btn => {
                const origIdx = parseInt(btn.dataset.origIdx, 10);
                return !correctIndices.includes(origIdx);
            });
            wrongButtons.sort(() => Math.random() - 0.5);
            wrongButtons.slice(0, 2).forEach(btn => {
                btn.disabled = true;
                btn.classList.add('opacity-20', 'pointer-events-none', 'line-through');
            });
        }

        function triggerSabotageOnLeader(debuffType) {
            // Prioritaskan lawan yang sedang online/tertinggi di klasemen
            const candidates = globalLeaderboardData.filter(p => p.deviceId && p.deviceId !== DEVICE_ID);
            if (candidates.length === 0) {
                score += 100;
                document.getElementById('current-score').innerText = score;
                showToast("Belum ada lawan aktif di klasemen — kamu mendapat +100 poin bonus!");
                return;
            }
            candidates.sort((a, b) => (b.score || 0) - (a.score || 0));
            const targetPlayer = candidates[0];

            if (typeof window.sendSabotageToCloud === 'function') {
                window.sendSabotageToCloud({
                    targetDeviceId: targetPlayer.deviceId,
                    targetName: targetPlayer.name,
                    attackerDeviceId: DEVICE_ID,
                    attackerName: currentPlayerName,
                    type: debuffType,
                    createdAt: Date.now()
                });
            }
            const label = debuffType === 'FREEZE_LEADER' ? 'Bekukan #1' : 'Acak Opsi';
            showToast(`Debuff ${label} dikirim ke ${targetPlayer.name}!`);
        }

        window.handleIncomingSabotage = function(sabotageDoc) {
            if (!sabotageDoc || sabotageDoc.targetDeviceId !== DEVICE_ID) return;
            if (document.getElementById('screen-quiz').classList.contains('hidden')) return;

            if (immuneQuestionsRemaining > 0) {
                showToast(`Perisai menangkis serangan ${sabotageDoc.attackerName || 'lawan'}!`);
                return;
            }

            immuneQuestionsRemaining = 1; // Perlindungan anti-spam 1 soal penuh
            renderInventoryUI();

            if (sabotageDoc.type === 'FREEZE_LEADER') {
                isFrozenByOpponent = true;
                freezeRemainingSec = 4;
                clearInterval(timerInterval);

                const overlay = document.getElementById('freeze-overlay');
                const attackerEl = document.getElementById('freeze-attacker-text');
                const countEl = document.getElementById('freeze-countdown');
                if (attackerEl) attackerEl.innerText = `${sabotageDoc.attackerName || 'Lawan'} membekukan layarmu! Timer dijeda sementara hingga es mencair.`;
                if (countEl) countEl.innerText = freezeRemainingSec;
                if (overlay) overlay.classList.remove('hidden');

                renderInventoryUI();

                clearInterval(freezeTimerInterval);
                freezeTimerInterval = setInterval(() => {
                    freezeRemainingSec--;
                    if (countEl) countEl.innerText = Math.max(0, freezeRemainingSec);
                    if (freezeRemainingSec <= 0) {
                        clearInterval(freezeTimerInterval);
                        isFrozenByOpponent = false;
                        if (overlay) overlay.classList.add('hidden');
                        renderInventoryUI();
                        resumeQuestionTimerOnly();
                    }
                }, 1000);
            } else if (sabotageDoc.type === 'GLITCH_SHUFFLE') {
                glitchShuffleActiveForNext = true;
                showToast(`Opsi jawabanmu diacak oleh ${sabotageDoc.attackerName || 'lawan'} pada soal berikutnya!`);
            }
        };

        function resumeQuestionTimerOnly() {
            const q = quizQuestions[currentQuestionIndex];
            if (!q || !document.getElementById('feedback-box').classList.contains('hidden')) return;
            const totalTime = q.time || 25;
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (isFrozenByOpponent) return;
                timeLeft--;
                document.getElementById('timer-text').innerText = Math.max(0, timeLeft);
                const pct = Math.max(0, (timeLeft / totalTime) * 100);
                document.getElementById('timer-bar').style.width = `${pct}%`;
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    handleTimeOut();
                }
            }, 1000);
        }

        function loadQuestion() {
            clearInterval(timerInterval);
            selectedMultipleIndices = [];
            doubleScoreActiveThisQuestion = false;
            powerupUsedThisQuestion = false;

            if (immuneQuestionsRemaining > 0) {
                immuneQuestionsRemaining--;
            }

            // Cek milestone dinamis (tengah kuis & kelipatan 10) untuk memberikan 1 Debuff otomatis
            const questionNumber = currentQuestionIndex + 1;
            const milestones = getDebuffMilestones();
            if (milestones.includes(questionNumber) && !awardedDebuffMilestones.has(questionNumber)) {
                awardedDebuffMilestones.add(questionNumber);
                const debuffRolled = rollWeightedPowerup('debuff');
                grantPowerupToInventory(debuffRolled, `Bonus Soal #${questionNumber}`);
            }

            renderInventoryUI();

            const q = quizQuestions[currentQuestionIndex];
            const totalQ = quizQuestions.length;

            document.getElementById('question-counter').innerText = `${currentQuestionIndex + 1} / ${totalQ}`;
            document.getElementById('category-badge').innerText = q.category;
            document.getElementById('question-text').innerText = q.question;

            const typeLabels = {
                'MC': 'Multiple Choice (Pilih 1)',
                'TF': 'True or False (Benar / Salah)',
                'MS': 'Multiple Select (Pilih Beberapa)',
                'TEXT': 'Isian Singkat (Ketik Jawaban)'
            };
            document.getElementById('question-type-label').innerText = typeLabels[q.type] || q.type;

            document.getElementById('feedback-box').classList.add('hidden');
            document.getElementById('submit-action-container').classList.add('hidden');

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            const shouldShuffleOpts = glitchShuffleActiveForNext && (q.type === 'MC' || q.type === 'MS');
            if (glitchShuffleActiveForNext) {
                glitchShuffleActiveForNext = false;
                optionsContainer.classList.add('glitch-active');
                setTimeout(() => optionsContainer.classList.remove('glitch-active'), 800);
            }

            if (q.type === 'MC' || q.type === 'TF') {
                const colors = [
                    'from-blue-600/80 to-indigo-700/80 border-blue-400/40',
                    'from-emerald-600/80 to-teal-700/80 border-emerald-400/40',
                    'from-amber-600/80 to-orange-700/80 border-amber-400/40',
                    'from-rose-600/80 to-pink-700/80 border-rose-400/40'
                ];
                const letters = ['A', 'B', 'C', 'D'];
                const indices = q.options.map((_, i) => i);
                if (shouldShuffleOpts) {
                    for (let i = indices.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [indices[i], indices[j]] = [indices[j], indices[i]];
                    }
                }

                indices.forEach((origIdx, dispIdx) => {
                    const optText = q.options[origIdx];
                    const btn = document.createElement('button');
                    btn.dataset.origIdx = String(origIdx);
                    btn.className = `option-btn w-full text-left p-4 rounded-2xl bg-gradient-to-r ${colors[dispIdx % colors.length]} border font-bold text-base sm:text-lg flex items-center gap-4 cursor-pointer`;
                    btn.innerHTML = `
                        <span class="w-9 h-9 rounded-xl bg-black/30 flex items-center justify-center font-extrabold text-sm shrink-0">${letters[dispIdx]}</span>
                        <span>${escapeHtml(optText)}</span>
                    `;
                    btn.onclick = () => handleSingleChoice(origIdx);
                    optionsContainer.appendChild(btn);
                });
            } else if (q.type === 'MS') {
                const indices = q.options.map((_, i) => i);
                if (shouldShuffleOpts) {
                    for (let i = indices.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [indices[i], indices[j]] = [indices[j], indices[i]];
                    }
                }
                indices.forEach((origIdx) => {
                    const optText = q.options[origIdx];
                    const btn = document.createElement('button');
                    btn.id = `ms-opt-${origIdx}`;
                    btn.dataset.origIdx = String(origIdx);
                    btn.className = `option-btn w-full text-left p-4 rounded-2xl bg-white/10 hover:bg-white/15 border-2 border-white/20 font-bold text-base flex items-center justify-between gap-4 cursor-pointer`;
                    btn.innerHTML = `
                        <span>${escapeHtml(optText)}</span>
                        <span id="ms-check-${origIdx}" class="w-7 h-7 rounded-lg border-2 border-white/40 flex items-center justify-center text-sm"></span>
                    `;
                    btn.onclick = () => toggleMultipleChoice(origIdx);
                    optionsContainer.appendChild(btn);
                });
                document.getElementById('submit-action-container').classList.remove('hidden');
            } else if (q.type === 'TEXT') {
                optionsContainer.innerHTML = `
                    <div>
                        <input type="text" id="text-answer-input" placeholder="Ketik jawabanmu di sini..." autocomplete="off"
                            class="w-full px-5 py-4 rounded-2xl bg-white text-slate-900 font-bold text-lg placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-amber-400">
                    </div>
                `;
                document.getElementById('submit-action-container').classList.remove('hidden');
                setTimeout(() => {
                    const inp = document.getElementById('text-answer-input');
                    if (inp) {
                        inp.focus();
                        inp.addEventListener('keypress', (e) => {
                            if (e.key === 'Enter') submitComplexAnswer();
                        });
                    }
                }, 50);
            }

            // Mulai Timer (terjeda otomatis bila layar membeku agar adil)
            timeLeft = q.time || 25;
            const totalTime = timeLeft;
            document.getElementById('timer-text').innerText = timeLeft;
            const timerBar = document.getElementById('timer-bar');
            timerBar.style.transition = 'none';
            timerBar.style.width = '100%';

            setTimeout(() => {
                timerBar.style.transition = 'width 1s linear';
            }, 30);

            timerInterval = setInterval(() => {
                if (isFrozenByOpponent) return;
                timeLeft--;
                document.getElementById('timer-text').innerText = Math.max(0, timeLeft);
                const pct = Math.max(0, (timeLeft / totalTime) * 100);
                timerBar.style.width = `${pct}%`;

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    handleTimeOut();
                }
            }, 1000);
        }

        function handleSingleChoice(selectedIdx) {
            if (isFrozenByOpponent) return;
            clearInterval(timerInterval);
            const q = quizQuestions[currentQuestionIndex];
            const isCorrect = (selectedIdx === q.answer);
            const buttons = document.querySelectorAll('#options-container button');

            buttons.forEach((btn) => {
                btn.disabled = true;
                const origIdx = parseInt(btn.dataset.origIdx, 10);
                if (origIdx === q.answer) {
                    btn.className = "w-full text-left p-4 rounded-2xl bg-emerald-500 text-slate-950 border-2 border-emerald-300 font-extrabold text-base sm:text-lg flex items-center gap-4 shadow-lg";
                } else if (origIdx === selectedIdx && !isCorrect) {
                    btn.className = "w-full text-left p-4 rounded-2xl bg-rose-600/90 text-white border-2 border-rose-400 font-bold text-base sm:text-lg flex items-center gap-4 opacity-90";
                } else {
                    btn.classList.add('opacity-40');
                }
            });

            const userAnswerText = q.options[selectedIdx];
            const correctAnswerText = q.options[q.answer];
            finalizeQuestionResult(isCorrect, userAnswerText, correctAnswerText);
        }

        function toggleMultipleChoice(idx) {
            if (isFrozenByOpponent) return;
            const btn = document.getElementById(`ms-opt-${idx}`);
            const box = document.getElementById(`ms-check-${idx}`);
            const pos = selectedMultipleIndices.indexOf(idx);

            if (pos === -1) {
                selectedMultipleIndices.push(idx);
                btn.classList.add('border-amber-400', 'bg-amber-500/20');
                box.classList.add('bg-amber-400', 'border-amber-400', 'text-slate-950');
                box.innerHTML = '<i class="fa-solid fa-check"></i>';
            } else {
                selectedMultipleIndices.splice(pos, 1);
                btn.classList.remove('border-amber-400', 'bg-amber-500/20');
                box.classList.remove('bg-amber-400', 'border-amber-400', 'text-slate-950');
                box.innerHTML = '';
            }
        }

        function submitComplexAnswer() {
            if (isFrozenByOpponent) return;
            const q = quizQuestions[currentQuestionIndex];

            if (q.type === 'MS') {
                if (selectedMultipleIndices.length === 0) return;
                clearInterval(timerInterval);
                document.getElementById('submit-action-container').classList.add('hidden');

                const sortedSelected = [...selectedMultipleIndices].sort((a, b) => a - b);
                const sortedCorrect = [...q.answer].sort((a, b) => a - b);
                const isCorrect = JSON.stringify(sortedSelected) === JSON.stringify(sortedCorrect);

                q.options.forEach((_, idx) => {
                    const btn = document.getElementById(`ms-opt-${idx}`);
                    btn.disabled = true;
                    if (sortedCorrect.includes(idx)) {
                        btn.className = "w-full text-left p-4 rounded-2xl bg-emerald-500 text-slate-950 border-2 border-emerald-300 font-extrabold text-base flex items-center justify-between gap-4";
                    } else if (sortedSelected.includes(idx)) {
                        btn.className = "w-full text-left p-4 rounded-2xl bg-rose-600 text-white border-2 border-rose-400 font-bold text-base flex items-center justify-between gap-4";
                    } else {
                        btn.classList.add('opacity-40');
                    }
                });

                const userAnswerText = sortedSelected.map(i => q.options[i]).join(', ');
                const correctAnswerText = sortedCorrect.map(i => q.options[i]).join(', ');
                finalizeQuestionResult(isCorrect, userAnswerText, correctAnswerText);

            } else if (q.type === 'TEXT') {
                const inp = document.getElementById('text-answer-input');
                const val = inp ? inp.value.trim() : '';
                if (!val) return;

                clearInterval(timerInterval);
                inp.disabled = true;
                document.getElementById('submit-action-container').classList.add('hidden');

                const normalized = val.toLowerCase();
                const isCorrect = q.acceptedAnswers.some(ans => ans.toLowerCase().trim() === normalized);
                const correctAnswerText = q.acceptedAnswers[0].toUpperCase();
                finalizeQuestionResult(isCorrect, val, correctAnswerText);
            }
        }

        function handleTimeOut() {
            const q = quizQuestions[currentQuestionIndex];
            document.getElementById('submit-action-container').classList.add('hidden');
            document.querySelectorAll('#options-container button, #options-container input').forEach(el => el.disabled = true);

            let correctText = "";
            if (q.type === 'MC' || q.type === 'TF') correctText = q.options[q.answer];
            else if (q.type === 'MS') correctText = q.answer.map(i => q.options[i]).join(', ');
            else correctText = q.acceptedAnswers[0].toUpperCase();

            finalizeQuestionResult(false, "Waktu Habis", correctText, true);
        }

        function finalizeQuestionResult(isCorrect, userAnswer, correctAnswer, isTimeout = false) {
            const q = quizQuestions[currentQuestionIndex];
            const totalTime = q.time || 25;
            const timeTaken = isTimeout ? totalTime : Math.max(1, totalTime - timeLeft);
            const targetStreak = getBalancedStreakTarget();
            let earnedPoints = 0;

            if (isCorrect) {
                correctCount++;
                currentStreak++;
                const speedBonus = Math.round((timeLeft / totalTime) * 400);
                earnedPoints = 600 + speedBonus;
                if (doubleScoreActiveThisQuestion) {
                    earnedPoints *= 2;
                }
                score += earnedPoints;
                document.getElementById('current-score').innerText = score;

                // Hadiah item acak setiap mencapai target streak dinamis
                const streakTarget = getStreakRewardTarget();
                if (currentStreak >= streakTarget) {
                    currentStreak = 0;
                    const rolledId = rollWeightedPowerup();
                    grantPowerupToInventory(rolledId, `Streak ${streakTarget} Benar`);
                }
            } else {
                currentStreak = 0;
            }
            renderInventoryUI();

            playerHistory.push({
                questionIndex: currentQuestionIndex,
                question: q.question,
                category: q.category,
                userAnswer: userAnswer,
                correctAnswer: correctAnswer,
                isCorrect: isCorrect,
                timeTaken: timeTaken,
                maxTime: totalTime,
                pointsEarned: earnedPoints,
                explanation: q.explanation
            });

            const fbBox = document.getElementById('feedback-box');
            const fbIcon = document.getElementById('feedback-icon');
            const fbTitle = document.getElementById('feedback-title');
            const fbPoints = document.getElementById('feedback-points');
            const fbExp = document.getElementById('feedback-explanation');

            fbBox.classList.remove('hidden', 'bg-emerald-500/20', 'border-emerald-400/50', 'bg-rose-500/20', 'border-rose-400/50');

            if (isCorrect) {
                fbBox.classList.add('bg-emerald-500/20', 'border-emerald-400/50');
                fbIcon.className = "w-8 h-8 rounded-full bg-emerald-400 text-slate-950 flex items-center justify-center font-bold text-lg";
                fbIcon.innerHTML = '<i class="fa-solid fa-check"></i>';
                fbTitle.innerText = "Jawaban Benar!";
                fbTitle.className = "font-extrabold text-lg text-emerald-300";
                fbPoints.innerText = `+${earnedPoints} poin`;
            } else {
                fbBox.classList.add('bg-rose-500/20', 'border-rose-400/50');
                fbIcon.className = "w-8 h-8 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-lg";
                fbIcon.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                fbTitle.innerText = isTimeout ? "Waktu Habis!" : `Kurang Tepat (Jawaban: ${correctAnswer})`;
                fbTitle.className = "font-extrabold text-lg text-rose-300";
                fbPoints.innerText = "+0 poin";
            }

            fbExp.innerText = q.explanation;
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < quizQuestions.length) {
                loadQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            document.getElementById('screen-quiz').classList.add('hidden');
            document.getElementById('screen-leaderboard').classList.remove('hidden');

            if (typeof window.unregisterActivePlayerCloud === 'function') {
                window.unregisterActivePlayerCloud(DEVICE_ID);
            }

            const totalQ = quizQuestions.length;
            const record = {
                id: DEVICE_ID,
                deviceId: DEVICE_ID,
                name: currentPlayerName,
                score: score,
                correct: correctCount,
                totalQuestions: totalQ,
                history: playerHistory,
                completedAt: new Date().toISOString()
            };

            safeSetStorage('quiz_completed_record_' + DEVICE_ID, JSON.stringify(record));
            applyDeviceLockUI(record);

            document.getElementById('player-result-card').classList.remove('hidden');
            document.getElementById('result-player-name').innerText = currentPlayerName;
            document.getElementById('result-correct-count').innerText = `${correctCount}/${totalQ}`;
            document.getElementById('result-total-score').innerText = score;

            renderAnswerReview();

            if (typeof window.saveScoreToCloud === 'function') {
                window.saveScoreToCloud(record);
            } else {
                upsertLocalLeaderboard(record);
            }
