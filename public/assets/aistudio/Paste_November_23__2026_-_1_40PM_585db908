        window.deleteSingleParticipantFromCloud = async function(targetDeviceId) {
            if (!db || !targetDeviceId) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'leaderboard', targetDeviceId);
                await deleteDoc(docRef);
            } catch (e) {
                console.error("Gagal menghapus peserta:", e);
            }
        };

        window.resetCloudLeaderboard = async function() {
            if (!db) return;
            try {
                const lbCol = collection(db, 'artifacts', appId, 'public', 'data', 'leaderboard');
                const snap = await getDocs(lbCol);
                const deletes = [];
                snap.forEach(d => deletes.push(deleteDoc(d.ref)));
                await Promise.all(deletes);
            } catch (e) {
                console.error("Gagal mereset leaderboard cloud:", e);
            }
        };

        initFirebaseSync();
    </script>
