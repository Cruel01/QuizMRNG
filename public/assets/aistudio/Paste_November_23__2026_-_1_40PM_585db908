<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuis Interaktif Nusantara & Trivia</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Inter & Font Awesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            overflow-x: hidden;
            max-width: 100%;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #2e1065 0%, #4c1d95 50%, #1e1b4b 100%);
            min-height: 100vh;
            min-height: 100dvh;
            color: #ffffff;
        }
        .quiz-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            word-wrap: break-word;
            overflow-wrap: break-word;
        }
        .option-btn {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            touch-action: manipulation;
        }
        @media (hover: hover) {
            .option-btn:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
            }
        }
        .option-btn:active:not(:disabled) {
            transform: scale(0.985);
        }
        @keyframes glitchShake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-3px); }
            75% { transform: translateX(3px); }
        }
        .glitch-active {
            animation: glitchShake 0.35s ease-in-out 2;
        }
    </style>
</head>
<body class="flex flex-col items-center justify-start sm:justify-center px-3 pt-4 pb-20 sm:p-6">

    <!-- Container Utama -->
    <div class="w-full max-w-3xl mx-auto min-w-0">

        <!-- ========================================== -->
        <!-- 1. LAYAR AWAL / LOBBY (SINGLE-ATTEMPT LOCK)-->
        <!-- ========================================== -->
        <div id="screen-start" class="quiz-card rounded-2xl sm:rounded-3xl p-5 sm:p-10 shadow-2xl text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-tr from-amber-400 to-orange-500 text-slate-950 text-2xl sm:text-3xl shadow-lg mb-3 sm:mb-4">
                <i class="fa-solid fa-bolt"></i>
            </div>

            <!-- Badge Mode Sesi (Menunggu Admin / Bebas / Live Bareng) -->
            <div class="mb-3">
                <span id="lobby-mode-badge" class="inline-flex items-center justify-center gap-1.5 text-[11px] sm:text-xs font-extrabold px-3 sm:px-3.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/40 animate-pulse max-w-full">
                    <i class="fa-solid fa-clock shrink-0"></i> <span class="truncate">Menunggu Admin Memilih Mode Kuis</span>
                </span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-2.5 sm:mb-3 leading-tight">
                Kuis Trivia Nusantara
            </h1>
            <p class="text-purple-200 text-xs sm:text-base max-w-lg mx-auto mb-5 sm:mb-6 leading-relaxed">
                Uji wawasanmu dalam <strong id="lobby-total-questions-text">30 pertanyaan</strong> seru! Dapatkan <strong>Buff & Debuff</strong> dari streak jawaban benar untuk menggandakan skor atau membekukan lawan.
            </p>

            <!-- Info Kategori & Aturan -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 mb-6 sm:mb-8 text-xs sm:text-sm">
                <div class="bg-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-white/10 flex sm:block items-center justify-between px-4 sm:px-3">
                    <div class="flex items-center gap-2 sm:block">
                        <i class="fa-solid fa-paw text-emerald-400 text-base sm:text-lg sm:mb-1"></i>
                        <div class="text-purple-200 text-xs sm:hidden">Manusia & Hewan</div>
                    </div>
                    <div id="lobby-count-cat1" class="font-bold">10 Soal</div>
                    <div class="text-purple-200 text-xs hidden sm:block">Manusia & Hewan</div>
                </div>
                <div class="bg-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-white/10 flex sm:block items-center justify-between px-4 sm:px-3">
                    <div class="flex items-center gap-2 sm:block">
                        <i class="fa-solid fa-brain text-sky-400 text-base sm:text-lg sm:mb-1"></i>
                        <div class="text-purple-200 text-xs sm:hidden">Logika & Hitungan</div>
                    </div>
                    <div id="lobby-count-cat2" class="font-bold">10 Soal</div>
                    <div class="text-purple-200 text-xs hidden sm:block">Logika & Hitungan</div>
                </div>
                <div class="bg-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-white/10 flex sm:block items-center justify-between px-4 sm:px-3">
                    <div class="flex items-center gap-2 sm:block">
                        <i class="fa-solid fa-earth-asia text-amber-400 text-base sm:text-lg sm:mb-1"></i>
                        <div class="text-purple-200 text-xs sm:hidden">Nusantara</div>
                    </div>
                    <div id="lobby-count-cat3" class="font-bold">10 Soal</div>
                    <div class="text-purple-200 text-xs hidden sm:block">Nusantara</div>
                </div>
            </div>

            <!-- Form Input Nama Pemain -->
            <div class="max-w-md mx-auto space-y-3.5 sm:space-y-4">
                <!-- Banner Menunggu Admin Menentukan Mode -->
                <div id="awaiting-admin-mode-banner" class="bg-indigo-500/20 border-2 border-indigo-400/40 rounded-2xl p-4 sm:p-5 text-center">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-indigo-400/20 text-indigo-300 flex items-center justify-center text-xl sm:text-2xl mx-auto mb-2 animate-pulse">
                        <i class="fa-solid fa-user-clock"></i>
                    </div>
                    <h3 class="font-extrabold text-base sm:text-lg text-indigo-200">Menunggu Penyelenggara (Admin)</h3>
                    <p class="text-xs sm:text-sm text-purple-100 mt-1 leading-relaxed">
                        Kuis belum dibuka. Halaman ini akan otomatis aktif begitu Admin memilih pelaksanaan secara <strong>Bebas</strong> atau <strong>Live Bareng</strong>.
                    </p>
                </div>

                <div id="lobby-input-container" class="hidden text-left">
                    <label for="player-name" class="block text-xs sm:text-sm font-semibold text-purple-200 mb-1.5 ml-1">Nama Pemain / Tim:</label>
                    <input type="text" id="player-name" placeholder="Masukkan namamu di sini..." maxlength="20"
                        class="w-full px-4 py-3.5 sm:px-5 sm:py-4 rounded-2xl bg-white text-slate-900 font-bold text-base sm:text-lg placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-amber-400 transition shadow-inner">
                    <p id="name-error" class="text-rose-300 text-xs mt-1.5 hidden ml-1"><i class="fa-solid fa-circle-exclamation mr-1"></i>Silakan masukkan nama terlebih dahulu!</p>
                </div>

                <!-- Notifikasi Jika Perangkat Sudah Pernah Mengerjakan Kuis -->
                <div id="already-played-banner" class="hidden bg-amber-500/20 border-2 border-amber-400/50 rounded-2xl p-4 sm:p-5 text-center">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-amber-400/20 text-amber-300 flex items-center justify-center text-xl sm:text-2xl mx-auto mb-2">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <h3 class="font-extrabold text-base sm:text-lg text-amber-300">Kuis Terkunci (Sudah Dikerjakan)</h3>
                    <p id="already-played-info" class="text-xs sm:text-sm text-purple-100 mt-1 leading-relaxed">
                        Perangkat/akun ini sudah menyelesaikan kuis 1 kali dan terekam di Leaderboard.
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-2.5 sm:gap-3 pt-1 sm:pt-2">
                    <button id="btn-start-quiz" disabled onclick="handleLobbyStartClick()" class="w-full sm:flex-1 bg-white/10 text-purple-300/60 font-bold text-sm sm:text-base py-3.5 sm:py-4 px-5 sm:px-6 rounded-2xl border border-white/10 cursor-not-allowed flex items-center justify-center gap-2">
                        <i class="fa-solid fa-hourglass-start"></i> Menunggu Admin...
                    </button>
                    <button id="btn-lobby-leaderboard" onclick="showLeaderboardOnly()" class="hidden w-full sm:w-auto bg-white/15 hover:bg-white/25 text-white font-semibold text-sm sm:text-base py-3.5 sm:py-4 px-5 sm:px-6 rounded-2xl border border-white/20 transition flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-trophy text-amber-400"></i> Lihat Leaderboard
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 1B. RUANG TUNGGU LIVE (WAITING LOBBY)      -->
        <!-- ========================================== -->
        <div id="screen-waiting-room" class="hidden quiz-card rounded-2xl sm:rounded-3xl p-5 sm:p-10 shadow-2xl text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-indigo-500/30 border border-indigo-400/40 text-amber-300 text-2xl sm:text-3xl mb-3 sm:mb-4 animate-pulse">
                <i class="fa-solid fa-users-line"></i>
            </div>
            <h2 class="text-xl sm:text-3xl font-extrabold mb-2">Menunggu Admin Memulai Kuis...</h2>
            <p class="text-purple-200 text-xs sm:text-sm max-w-md mx-auto mb-5 sm:mb-6 leading-relaxed">
                Kamu sudah masuk ke ruang tunggu sebagai <strong id="waiting-my-name" class="text-amber-300">Pemain</strong>. Kuis akan otomatis dimulai serentak begitu Admin menekan tombol Mulai!
            </p>

            <div class="bg-slate-950/50 border border-white/15 rounded-2xl p-4 sm:p-5 max-w-lg mx-auto mb-5 sm:mb-6">
                <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-purple-200 mb-3">
                    <span>Peserta di Ruang Tunggu</span>
                    <span id="waiting-players-count" class="bg-emerald-500/20 text-emerald-300 px-2.5 py-0.5 rounded-full">1 Bergabung</span>
                </div>
                <div id="waiting-players-list" class="flex flex-wrap justify-center gap-2 max-h-48 overflow-y-auto">
                    <!-- Daftar chip pemain yang sudah join -->
                </div>
            </div>

            <button onclick="leaveWaitingRoom()" class="text-xs sm:text-sm text-purple-300 hover:text-white underline py-2 px-4 cursor-pointer">
                Ganti Nama / Keluar Ruang Tunggu
            </button>
        </div>

        <!-- ========================================== -->
        <!-- 2. LAYAR PERMAINAN KUIS                    -->
        <!-- ========================================== -->
        <div id="screen-quiz" class="hidden space-y-3 sm:space-y-4 min-w-0">
            <!-- Header Bar: Progress, Kategori, Skor -->
            <div class="quiz-card rounded-2xl p-3 sm:p-4 flex items-center justify-between gap-2 min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2.5 min-w-0">
                    <span id="question-counter" class="bg-white/20 px-2.5 sm:px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm shrink-0">
                        1 / 30
                    </span>
                    <span id="category-badge" class="bg-indigo-500/40 border border-indigo-400/30 px-2.5 sm:px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold text-indigo-200 truncate">
                        Kategori
                    </span>
                </div>
                <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                    <span id="active-status-pills" class="hidden sm:flex flex-wrap items-center gap-1.5"></span>
                    <div class="flex items-center gap-1.5 sm:gap-2 bg-slate-900/60 px-3 sm:px-4 py-1.5 rounded-xl border border-white/10">
                        <i class="fa-solid fa-star text-amber-400 text-xs sm:text-base"></i>
                        <span id="current-score" class="font-extrabold text-base sm:text-lg">0</span>
                    </div>
                </div>
            </div>

            <!-- Timer Bar -->
            <div class="w-full bg-slate-900/70 h-2.5 sm:h-3 rounded-full overflow-hidden p-0.5 border border-white/10">
                <div id="timer-bar" class="bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 h-full rounded-full transition-all duration-1000 ease-linear" style="width: 100%;"></div>
            </div>

            <!-- Panel Inventory Buff & Debuff (Maksimal 2 Slot) -->
            <div id="powerup-inventory-bar" class="quiz-card rounded-2xl p-3 sm:p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-3">
                <div class="flex items-center justify-between sm:justify-start gap-2 text-xs">
                    <span class="bg-amber-400/20 text-amber-300 border border-amber-400/30 px-2.5 py-1 rounded-lg font-extrabold shrink-0">
                        <i class="fa-solid fa-fire mr-1"></i>Streak: <span id="hud-streak-count">0</span>/<span id="hud-streak-target">8</span>
                    </span>
                    <span id="hud-milestone-hint" class="text-[11px] sm:text-xs text-purple-200 truncate">
                        • Item tiap 8 benar • Debuff di soal #10, #15, #20, #30
                    </span>
                </div>
                <div id="inventory-slots" class="grid grid-cols-2 gap-2 w-full sm:w-80">
                    <!-- 2 Slot Inventory diisi via JavaScript -->
                </div>
            </div>

            <!-- Kartu Pertanyaan & Opsi Jawaban -->
            <div class="relative quiz-card rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-2xl overflow-hidden min-w-0">
                <!-- Overlay Beku (Freeze Debuff dari Lawan) -->
                <div id="freeze-overlay" class="hidden absolute inset-0 z-30 bg-cyan-950/90 backdrop-blur-md flex flex-col items-center justify-center text-center p-5 sm:p-6 border-2 border-cyan-300/60 rounded-2xl sm:rounded-3xl">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-cyan-400/20 text-cyan-300 flex items-center justify-center text-3xl sm:text-4xl mb-3 animate-bounce border border-cyan-300/40">
                        <i class="fa-solid fa-snowflake"></i>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-extrabold text-cyan-200 mb-1">Layarmu Dibekukan!</h3>
                    <p id="freeze-attacker-text" class="text-xs sm:text-sm text-cyan-100/90 max-w-sm mb-3">
                        Pemain lain mengirim serangan es! Timer dijeda sementara hingga es mencair.
                    </p>
                    <div class="bg-cyan-400 text-slate-950 font-extrabold px-4 py-1.5 rounded-xl text-xs sm:text-sm">
                        Mencair dalam <span id="freeze-countdown">4</span> detik...
                    </div>
                </div>

                <!-- Tipe Soal Tag -->
                <div class="flex items-center justify-between gap-2 mb-3 sm:mb-4">
                    <span id="question-type-label" class="text-[11px] sm:text-xs uppercase tracking-wider font-bold text-amber-300 bg-amber-500/20 px-2.5 sm:px-3 py-1 rounded-lg truncate">
                        Multiple Choice
                    </span>
                    <span class="text-xs text-purple-200 font-semibold shrink-0">
                        <i class="fa-regular fa-clock mr-1"></i><span id="timer-text">30</span>d
                    </span>
                </div>

                <!-- Teks Pertanyaan -->
                <h2 id="question-text" class="text-lg sm:text-2xl font-bold leading-snug mb-5 sm:mb-8 break-words">
                    Memuat pertanyaan...
                </h2>

                <!-- Area Opsi Jawaban (Dinamis sesuai tipe soal) -->
                <div id="options-container" class="space-y-2.5 sm:space-y-3">
                    <!-- Diisi via JavaScript -->
                </div>

                <!-- Tombol Submit Khusus Multiple Select & Fill in the Blank -->
                <div id="submit-action-container" class="mt-5 sm:mt-6 hidden">
                    <button id="btn-submit-answer" onclick="submitComplexAnswer()" class="w-full bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 text-slate-950 font-extrabold py-3.5 sm:py-4 rounded-2xl shadow-lg transition cursor-pointer">
                        Kirim Jawaban
                    </button>
                </div>

                <!-- Feedback & Penjelasan Langsung Setelah Menjawab -->
                <div id="feedback-box" class="hidden mt-5 sm:mt-6 p-4 sm:p-5 rounded-2xl border transition-all">
                    <div class="flex items-center gap-2.5 sm:gap-3 mb-2">
                        <div id="feedback-icon" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center font-bold text-base sm:text-lg shrink-0"></div>
                        <h3 id="feedback-title" class="font-extrabold text-sm sm:text-lg leading-tight"></h3>
                        <span id="feedback-points" class="ml-auto font-bold text-xs sm:text-sm px-2 sm:px-2.5 py-1 rounded-lg bg-black/20 shrink-0"></span>
                    </div>
                    <p id="feedback-explanation" class="text-xs sm:text-sm leading-relaxed opacity-95"></p>
                    <button onclick="nextQuestion()" class="mt-4 w-full bg-white text-slate-900 hover:bg-purple-100 font-extrabold text-sm sm:text-base py-3 sm:py-3.5 rounded-xl shadow transition flex items-center justify-center gap-2 cursor-pointer">
                        Lanjut Soal Berikutnya <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 3. LAYAR HASIL, LEADERBOARD & KUNCI JAWABAN-->
        <!-- ========================================== -->
        <div id="screen-leaderboard" class="hidden quiz-card rounded-2xl sm:rounded-3xl p-5 sm:p-10 shadow-2xl min-w-0">
            <div class="text-center mb-6 sm:mb-8">
                <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-amber-400 text-slate-950 text-2xl sm:text-3xl shadow-lg mb-3 sm:mb-4">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <h2 class="text-xl sm:text-3xl font-extrabold">Papan Peringkat (Leaderboard)</h2>
                <p id="leaderboard-subtitle" class="text-purple-200 text-xs sm:text-sm mt-1">Klasemen skor tertinggi seluruh peserta secara real-time</p>
            </div>

            <!-- Ringkasan Skor Pemain Saat Ini (Muncul jika baru selesai main) -->
            <div id="player-result-card" class="hidden bg-gradient-to-r from-indigo-600/60 to-purple-600/60 border border-indigo-400/40 rounded-2xl p-4 sm:p-5 mb-5 sm:mb-6 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-center sm:text-left">
                <div class="min-w-0 max-w-full">
                    <div class="text-[11px] sm:text-xs uppercase tracking-wider text-indigo-200 font-bold">Hasil Permainanmu</div>
                    <div id="result-player-name" class="text-lg sm:text-xl font-extrabold text-white truncate">Pemain</div>
                </div>
                <div class="flex items-center justify-center gap-5 sm:gap-6 text-center">
                    <div>
                        <div class="text-[11px] sm:text-xs text-purple-200">Benar</div>
                        <div id="result-correct-count" class="text-lg sm:text-xl font-extrabold text-emerald-400">0/30</div>
                    </div>
                    <div class="h-8 w-px bg-white/20"></div>
                    <div>
                        <div class="text-[11px] sm:text-xs text-purple-200">Total Skor</div>
                        <div id="result-total-score" class="text-xl sm:text-2xl font-extrabold text-amber-400">0</div>
                    </div>
                </div>
            </div>

            <!-- Tabel Klasemen Leaderboard -->
            <div class="bg-slate-950/50 rounded-2xl border border-white/10 overflow-hidden mb-6 sm:mb-8">
                <div class="flex items-center justify-between gap-2 bg-white/5 px-3 sm:px-4 py-2.5 border-b border-white/10">
                    <span class="text-[11px] sm:text-xs text-purple-200 font-semibold"><i class="fa-solid fa-signal text-emerald-400 mr-1.5"></i>Live Klasemen</span>
                    <button onclick="manualRefreshLeaderboard(this)" class="text-[11px] sm:text-xs bg-white/10 hover:bg-white/20 text-amber-300 font-bold px-2.5 sm:px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer shrink-0">
                        <i class="fa-solid fa-arrows-rotate"></i> <span>Refresh</span>
                    </button>
                </div>
                <div class="grid grid-cols-12 bg-white/10 px-3 sm:px-4 py-2.5 sm:py-3 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-purple-200">
                    <div class="col-span-2 text-center">Rank</div>
                    <div class="col-span-5">Nama Pemain</div>
                    <div class="col-span-2 text-center">Benar</div>
                    <div class="col-span-3 text-right">Skor</div>
                </div>
                <div id="leaderboard-list" class="divide-y divide-white/10 max-h-80 overflow-y-auto">
                    <!-- Diisi via JavaScript -->
                </div>
            </div>

            <!-- Rekap Kunci Jawaban & Pembahasan (Muncul di Akhir Sesi Kuis) -->
            <div id="answer-review-section" class="hidden mb-6 sm:mb-8">
                <div class="flex items-center gap-2 mb-3 sm:mb-4">
                    <i class="fa-solid fa-clipboard-check text-emerald-400 text-lg sm:text-xl"></i>
                    <h3 class="text-lg sm:text-xl font-extrabold">Kunci Jawaban & Pembahasan</h3>
                </div>
                <div id="answer-review-list" class="space-y-2.5 sm:space-y-3 max-h-96 overflow-y-auto pr-1">
                    <!-- Diisi via JavaScript -->
                </div>
            </div>

            <!-- Tombol Aksi Bawah -->
            <div class="flex flex-col sm:flex-row justify-center gap-3">
                <button onclick="backToLockedLobby()" class="w-full sm:w-auto bg-white/15 hover:bg-white/25 text-white font-bold text-sm sm:text-base py-3.5 px-8 rounded-2xl border border-white/20 transition flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-house"></i> Kembali ke Beranda
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 4. MODAL LOGIN & DASHBOARD ADMIN           -->
        <!-- ========================================== -->
        <div class="fixed bottom-3 right-3 sm:bottom-4 sm:right-4 flex items-center gap-1.5 sm:gap-2 z-40 max-w-[calc(100vw-1.5rem)]">
            <div id="cloud-status-badge" class="bg-slate-900/90 text-purple-200/90 text-[10px] sm:text-[11px] px-2.5 sm:px-3 py-1.5 sm:py-2 rounded-xl border border-white/15 backdrop-blur-md flex items-center gap-1.5 min-w-0 shadow-lg">
                <span id="cloud-status-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0"></span>
                <span id="cloud-status-text" class="truncate">Menghubungkan Cloud...</span>
            </div>
            <button onclick="openAdminModal()" title="Panel Admin" class="bg-slate-900/90 hover:bg-slate-800 text-purple-100 hover:text-white text-[11px] sm:text-xs px-3 py-1.5 sm:py-2 rounded-xl border border-white/15 backdrop-blur-md transition flex items-center gap-1.5 cursor-pointer shrink-0 shadow-lg">
                <i class="fa-solid fa-shield-halved text-indigo-300"></i> <span>Admin</span>
            </button>
        </div>

        <!-- Modal Login Admin -->
