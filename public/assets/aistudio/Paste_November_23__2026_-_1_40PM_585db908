                            <strong>Jawabanmu:</strong> ${escapeHtml(item.userAnswer)}
                        </div>
                        ${!item.isCorrect ? `<div class="text-emerald-300"><strong>Kunci Jawaban:</strong> ${escapeHtml(item.correctAnswer)}</div>` : ''}
                    </div>
                    <p class="text-xs text-purple-200/90 bg-black/20 p-2.5 rounded-xl">${escapeHtml(item.explanation)}</p>
