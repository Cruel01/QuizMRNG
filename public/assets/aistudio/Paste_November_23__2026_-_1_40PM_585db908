                    : "bg-emerald-400 hover:bg-emerald-500 text-slate-950 font-extrabold text-xs sm:text-sm py-2 px-4 rounded-xl shadow transition flex items-center gap-1.5 cursor-pointer";
            }

            if (adminLockBanner) {
                if (sessionMode === 'unconfigured') {
                    adminLockBanner.innerHTML = `<i class="fa-solid fa-clock text-amber-300 mr-1.5"></i>Beranda peserta saat ini <strong>terkunci menunggu</strong> kamu memilih <strong>Mode Bebas</strong> atau <strong>Buka Lobby Live</strong>.`;
