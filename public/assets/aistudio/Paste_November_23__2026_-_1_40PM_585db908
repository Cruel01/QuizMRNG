            document.getElementById('modal-confirm-reset').classList.add('hidden');
            unlockThisDeviceUI();
            globalLeaderboardData = [];

            renderLeaderboardList([]);
            renderAdminStatistics();

            if (typeof window.resetCloudLeaderboard === 'function') {
                window.resetCloudLeaderboard();
            }
            showToast("Seluruh skor peserta & kunci perangkat berhasil direset.");
        }

        function exportAdminCSV() {
            const headers = ["Rank", "Nama Peserta", "Benar", "Total Soal", "Skor", "Soal Salah", "Soal Tercepat", "Total Waktu (Detik)", "Waktu Selesai", "ID Perangkat"];
            const rows = globalLeaderboardData.map((p, idx) => {
                const hist = Array.isArray(p.history) ? p.history : [];
                const wrongList = hist.map((h, i) => (!h.isCorrect ? `No.${i + 1}` : null)).filter(Boolean).join('; ') || 'Tidak ada';
                let totalSec = 0;
                let fastStr = '-';
                let minSec = Infinity;
                hist.forEach((h, i) => {
                    if (typeof h.timeTaken === 'number') {
                        totalSec += h.timeTaken;
                        if (h.timeTaken < minSec) {
                            minSec = h.timeTaken;
                            fastStr = `No.${i + 1} (${h.timeTaken}d)`;
                        }
                    }
                });

                return [
                    idx + 1,
                    `"${(p.name || '').replace(/"/g, '""')}"`,
                    p.correct || 0,
                    p.totalQuestions || quizQuestions.length,
                    p.score || 0,
                    `"${wrongList}"`,
                    `"${fastStr}"`,
                    totalSec || '-',
                    `"${p.completedAt ? new Date(p.completedAt).toLocaleString('id-ID') : '-'}"`,
                    `"${p.deviceId || '-'}"`
                ];
            });

            const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `hasil_kuis_nusantara_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function escapeHtml(str) {
            if (typeof str !== 'string') return str;
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        // Inisialisasi Awal UI
        updateLobbyCategoryStats();
        checkLocalLockState();
        applySessionModeUI();
    </script>

