            try {
                const aRef = doc(db, 'artifacts', appId, 'public', 'data', 'active_players', devId);
                await deleteDoc(aRef);
            } catch (e) {}
        };

        window.clearActiveSessionPlayersCloud = async function() {
            if (!db) return;
            try {
                const activeCol = collection(db, 'artifacts', appId, 'public', 'data', 'active_players');
                const snapA = await getDocs(activeCol);
                const dels = [];
                snapA.forEach(d => dels.push(deleteDoc(d.ref)));
                const waitCol = collection(db, 'artifacts', appId, 'public', 'data', 'waiting_room');
                const snapW = await getDocs(waitCol);
                snapW.forEach(d => dels.push(deleteDoc(d.ref)));
                await Promise.all(dels);
            } catch (e) {}
        };

        window.saveScoreToCloud = async function(record) {
            upsertLocalLeaderboard(record);
            if (!db) return;
            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'leaderboard', record.deviceId);
                await setDoc(docRef, record);
                setCloudBadge('ok', 'Skor Tersimpan di Cloud');
            } catch (e) {
                console.error("Gagal menyimpan skor ke cloud:", e);
                setCloudBadge('err', 'Gagal Simpan (Cek Rules)');
                showToast("Gagal simpan ke Firebase: periksa tab Rules di Firestore!");
            }
        };

        window.fetchCloudLeaderboardOnce = async function() {
            if (!db) return;
            try {
                const lbCol = collection(db, 'artifacts', appId, 'public', 'data', 'leaderboard');
                const snap = await getDocs(lbCol);
                const list = [];
                snap.forEach(d => list.push(d.data()));
                renderLeaderboardList(list);
                setCloudBadge('ok', 'Cloud Terhubung');
            } catch (e) {
                console.error("Gagal refresh leaderboard:", e);
                setCloudBadge('err', 'Cek Rules Firestore!');
            }
        };

        window.saveQuestionsToCloud = async function(questionsArray) {
            if (!db) return;
            try {
                const configDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'questions_v2');
                await setDoc(configDocRef, { items: questionsArray, updatedAt: new Date().toISOString() });
            } catch (e) {
                console.error("Gagal menyinkronkan soal CRUD ke cloud:", e);
                showToast("Gagal menyimpan soal ke Firebase (cek Rules Firestore).");
            }
        };

        window.sendSabotageToCloud = async function(sabotagePayload) {
            if (!db || !sabotagePayload.targetDeviceId) return;
            try {
                const targetRef = doc(db, 'artifacts', appId, 'public', 'data', 'sabotage', sabotagePayload.targetDeviceId);
                await setDoc(targetRef, sabotagePayload);
            } catch (e) {
                console.error("Gagal mengirim sabotase ke cloud:", e);
