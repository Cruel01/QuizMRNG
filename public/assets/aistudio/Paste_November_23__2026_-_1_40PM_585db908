        function openPlayerDetailModal(playerIdx) {
            const player = globalLeaderboardData[playerIdx];
            if (!player) return;

            document.getElementById('detail-player-name').innerText = player.name || 'Peserta';
            const dateStr = player.completedAt ? new Date(player.completedAt).toLocaleString('id-ID') : '-';
            document.getElementById('detail-player-meta').innerText = `ID: ${player.deviceId || '-'} • Selesai: ${dateStr}`;

            const totalQ = player.totalQuestions || (Array.isArray(player.history) ? player.history.length : quizQuestions.length);
            document.getElementById('detail-stat-score').innerText = player.score || 0;
            document.getElementById('detail-stat-accuracy').innerText = `${player.correct || 0}/${totalQ}`;

            const history = Array.isArray(player.history) ? player.history : [];
            let totalDuration = 0;
            let fastestItem = null;
            let fastestNum = null;
            const wrongItems = [];

            history.forEach((h, i) => {
                const dur = typeof h.timeTaken === 'number' ? h.timeTaken : null;
                if (dur !== null) {
                    totalDuration += dur;
                    if (!fastestItem || dur < fastestItem.timeTaken) {
                        fastestItem = h;
                        fastestNum = i + 1;
                    }
                }
                if (!h.isCorrect) {
                    wrongItems.push({ num: i + 1, ...h });
                }
            });

            document.getElementById('detail-stat-fastest').innerText = fastestItem
                ? `Soal #${fastestNum} (${fastestItem.timeTaken}d)`
                : '-';
            document.getElementById('detail-stat-totaltime').innerText = totalDuration > 0 ? `${totalDuration} detik` : '-';

            const wrongSummaryEl = document.getElementById('detail-wrong-summary');
            if (history.length === 0) {
                wrongSummaryEl.className = "mb-4 p-3.5 rounded-2xl bg-white/10 border border-white/15 text-xs text-purple-200";
                wrongSummaryEl.innerHTML = `<i class="fa-solid fa-circle-info mr-1.5"></i>Riwayat jawaban detail belum tersedia untuk sesi ini.`;
            } else if (wrongItems.length === 0) {
                wrongSummaryEl.className = "mb-4 p-3.5 rounded-2xl bg-emerald-500/15 border border-emerald-400/30 text-xs text-emerald-200 font-semibold";
                wrongSummaryEl.innerHTML = `<i class="fa-solid fa-circle-check mr-1.5"></i>Luar biasa! Peserta menjawab seluruh soal dengan benar tanpa kesalahan.`;
            } else {
                wrongSummaryEl.className = "mb-4 p-3.5 rounded-2xl bg-rose-500/15 border border-rose-400/30 text-xs text-rose-200";
                const listNums = wrongItems.map(w => `<strong>Soal #${w.num}</strong>`).join(', ');
                wrongSummaryEl.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1.5"></i>Peserta melakukan <strong>${wrongItems.length} kesalahan</strong> pada: ${listNums}.`;
            }

            const breakdownEl = document.getElementById('detail-questions-breakdown');
            breakdownEl.innerHTML = '';

            history.forEach((h, i) => {
                const isFastest = (fastestNum === i + 1 && typeof h.timeTaken === 'number');
                const durBadge = typeof h.timeTaken === 'number'
                    ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-md ${isFastest ? 'bg-sky-400 text-slate-950' : 'bg-white/10 text-purple-200'}">
                        <i class="fa-regular fa-clock mr-1"></i>${h.timeTaken}d ${isFastest ? '• Tercepat!' : ''}
                       </span>`
                    : '';

                const card = document.createElement('div');
                card.className = `p-3.5 rounded-2xl border ${h.isCorrect ? 'bg-emerald-500/10 border-emerald-400/30' : 'bg-rose-500/10 border-rose-400/30'}`;
                card.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-extrabold ${h.isCorrect ? 'text-emerald-300' : 'text-rose-300'}">
                                Soal #${i + 1} • ${h.isCorrect ? 'BENAR' : 'SALAH'}
                            </span>
                            <span class="text-[11px] text-purple-300">(${escapeHtml(h.category || '')})</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            ${durBadge}
