        function toggleCrudTypeFields() {
            const type = document.getElementById('crud-type').value;
            document.getElementById('crud-options-group').classList.toggle('hidden', type === 'TF' || type === 'TEXT');
            document.getElementById('crud-answer-mc-group').classList.toggle('hidden', type !== 'MC');
            document.getElementById('crud-answer-tf-group').classList.toggle('hidden', type !== 'TF');
            document.getElementById('crud-answer-ms-group').classList.toggle('hidden', type !== 'MS');
            document.getElementById('crud-answer-text-group').classList.toggle('hidden', type !== 'TEXT');
        }

        function openQuestionEditorModal(editIdx = -1) {
            document.getElementById('crud-edit-index').value = editIdx;
            document.getElementById('crud-form-error').classList.add('hidden');
            document.querySelectorAll('.crud-ms-check').forEach(cb => cb.checked = false);

            if (editIdx >= 0 && quizQuestions[editIdx]) {
                const q = quizQuestions[editIdx];
                document.getElementById('crud-modal-title').innerText = `Edit Soal #${editIdx + 1}`;
                document.getElementById('crud-category').value = q.category;
                document.getElementById('crud-type').value = q.type;
                document.getElementById('crud-time').value = q.time || 25;
                document.getElementById('crud-question').value = q.question;
                document.getElementById('crud-explanation').value = q.explanation || '';

                if (q.type === 'MC' || q.type === 'MS') {
                    for (let i = 0; i < 4; i++) {
                        document.getElementById(`crud-opt-${i}`).value = (q.options && q.options[i]) || '';
                    }
                }
                if (q.type === 'MC') {
                    document.getElementById('crud-answer-mc').value = String(q.answer);
                } else if (q.type === 'TF') {
                    document.getElementById('crud-answer-tf').value = String(q.answer);
                } else if (q.type === 'MS') {
                    (q.answer || []).forEach(ansIdx => {
                        const cb = document.querySelector(`.crud-ms-check[value="${ansIdx}"]`);
                        if (cb) cb.checked = true;
                    });
                } else if (q.type === 'TEXT') {
                    document.getElementById('crud-answer-text').value = (q.acceptedAnswers || []).join(', ');
                }
            } else {
                document.getElementById('crud-modal-title').innerText = "Tambah Soal Baru";
                document.getElementById('crud-category').value = "Manusia & Hewan";
                document.getElementById('crud-type').value = "MC";
                document.getElementById('crud-time').value = 25;
                document.getElementById('crud-question').value = '';
                document.getElementById('crud-explanation').value = '';
                for (let i = 0; i < 4; i++) document.getElementById(`crud-opt-${i}`).value = '';
                document.getElementById('crud-answer-text').value = '';
            }

            toggleCrudTypeFields();
            document.getElementById('modal-crud-question').classList.remove('hidden');
        }

        function closeQuestionEditorModal() {
            document.getElementById('modal-crud-question').classList.add('hidden');
