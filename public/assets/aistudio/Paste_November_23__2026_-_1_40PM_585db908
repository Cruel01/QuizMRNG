        function setSessionMode(newMode) {
            const { isFreeLockedOut, isLiveLockedOut } = getSessionLockFlags();
            if (newMode === 'free' && isFreeLockedOut) {
                showToast("Mode Bebas terkunci karena sesi Live sudah memiliki peserta/berjalan!");
                return;
            }
            if ((newMode === 'live_waiting' || newMode === 'live_started') && isLiveLockedOut) {
                showToast("Fitur Live terkunci karena sudah ada peserta yang mengerjakan/selesai di Mode Bebas!");
                return;
            }

            sessionMode = newMode;
            if (newMode === 'live_started') {
                liveSessionRunId = 'LIVE-' + Date.now();
            }
            applySessionModeUI();
            if (typeof window.saveSessionStateToCloud === 'function') {
                window.saveSessionStateToCloud({
                    mode: sessionMode,
                    runId: liveSessionRunId,
                    updatedAt: Date.now()
                });
            }
            const labels = {
                'free': 'Mode Bebas diaktifkan! Peserta di beranda kini bisa mulai mengerjakan.',
                'live_waiting': 'Ruang Tunggu Live dibuka! Peserta yang masuk akan menunggu aba-aba mulai.',
                'live_started': 'Kuis Live DIMULAI serentak untuk semua peserta di ruang tunggu!'
            };
            showToast(labels[newMode] || 'Mode diperbarui');
        }

