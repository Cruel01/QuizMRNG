                    <p class="text-xs sm:text-sm font-bold text-white mb-1.5">${escapeHtml(h.question)}</p>
                    <div class="text-xs space-y-0.5">
                        <div class="${h.isCorrect ? 'text-emerald-300' : 'text-rose-300'}">
